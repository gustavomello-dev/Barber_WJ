# Arquivos sensiveis: nunca entram na imagem Docker.
.git
**/.git
**/.git/**
.env
.env.*
**/.env
**/.env.*
**/*credentials*
**/*.key
**/*.pem

# Dependencias locais, logs e cache.
node_modules
**/node_modules
**/node_modules/**
*.log
**/*.log
npm-debug.log*
.vscode
.idea
**/.agents
**/.agents/**

# Materiais nao usados pela imagem em runtime.
**/*.sql
**/*.backup
**/*.dump
README*
render.yaml
compose.yaml
docker-compose.yml
Dockerfile*
.dockerignore
